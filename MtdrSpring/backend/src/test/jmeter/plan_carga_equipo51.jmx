  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Plan de Carga — Equipo 51" enabled="true">
      <stringProp name="TestPlan.comments">Prueba de carga para los endpoints REST de chatbotOracle. Equipo 51 — TC3004B</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
